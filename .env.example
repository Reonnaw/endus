NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Project Settings > API Keys > publishable (or legacy anon). Dashboard reads, RLS select-only.
SUPABASE_SERVICE_ROLE_KEY=         # Project Settings > API Keys > secret (or legacy service_role). SERVER ONLY, never NEXT_PUBLIC_.
INGEST_SECRET=                     # random 32+ bytes, e.g. `openssl rand -hex 32`. Same value in the EMQX header x-ingest-secret.
# Only if the web ever publishes to i2aspo/<dev>/session (not built yet), server only:
# MQTT_URL=
# MQTT_USERNAME=
# MQTT_PASSWORD=
